worker_processes 1;
pid /run/comicatlas-public-reading-nginx.pid;
error_log stderr warn;
events { worker_connections 512; }
http {
    # 白名单同时限定方法与路径；新增接口默认不对公网开放。
    map "$request_method:$uri" $reading_allowed {
        default 0;
        ~^(GET|HEAD):/(|index\.html|library|history|comic/[0-9]+|reader/[0-9]+|videos/[0-9]+)$ 1;
        ~^(GET|HEAD):/(favicon\.svg|assets/[a-zA-Z0-9_./-]+\.(js|css|woff2?|ttf|svg|png|webp|jpg))$ 1;
        ~^(GET|HEAD):/api/(comics|comics/[0-9]+|comics/[0-9]+/catalog|chapters/[0-9]+|categories|tags|history/page|history/[0-9]+)$ 1;
        ~^PUT:/api/history/[0-9]+$ 1;
        ~^PUT:/api/(comics|chapters|pages)/[0-9]+/reaction$ 1;
        ~*^(GET|HEAD):/files/(hq|lq|thumbs)/.+\.(jpg|jpeg|png|gif|webp|avif|bmp|mp4|m4v|webm|mov|mkv|avi)$ 1;
    }
    server {
        listen __PUBLIC_PORT__;
        server_name _;
        client_max_body_size 16k;
        # 不允许不同代理对转义路径、矩阵参数产生不同解释。
        if ($request_uri ~* "^[^?]*(%25|%2f|%5c|%2e|;|\\\\)") { return 403; }
        if ($reading_allowed = 0) { return 403; }
        location / {
            proxy_pass http://127.0.0.1:__TUNNEL_PORT__;
            proxy_http_version 1.1;
            proxy_set_header Host localhost;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $remote_addr;
            proxy_set_header Accept-Encoding "";
            proxy_read_timeout 120s;
            proxy_buffering off;
            # 同一前端产物按入口选择能力，本地管理界面不受影响。
            sub_filter '<head>' '<head><meta name="comicatlas-access" content="public-reading">';
            sub_filter_once on;
            proxy_hide_header Cache-Control;
            add_header Cache-Control "private, no-cache" always;
            add_header X-Content-Type-Options nosniff always;
        }
    }
}
