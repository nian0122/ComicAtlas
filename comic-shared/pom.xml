<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.comicatlas</groupId>
        <artifactId>comic-atlas</artifactId>
        <version>0.0.1-SNAPSHOT</version>
    </parent>

    <artifactId>comic-shared</artifactId>
    <packaging>jar</packaging>
    <name>Comic Shared</name>
    <description>阅读服务与管理服务共享的持久化层与基础能力（实体/Mapper/DTO/common 基础设施，包名保持 com.comicatlas.api.* 不变）</description>

    <properties>
        <!-- 上游 -Dtest 指定 api-service 测试时，comic-shared 无匹配测试不视为失败 -->
        <surefire.failIfNoSpecifiedTests>false</surefire.failIfNoSpecifiedTests>
    </properties>

    <dependencies>
        <!-- Comic Common（事件 DTO / MQ 契约 / 工具） -->
        <dependency>
            <groupId>com.comicatlas</groupId>
            <artifactId>comic-common</artifactId>
            <version>${project.version}</version>
        </dependency>

        <!-- MyBatis Plus（Mapper BaseMapper / LambdaQueryWrapper） -->
        <dependency>
            <groupId>com.baomidou</groupId>
            <artifactId>mybatis-plus-spring-boot3-starter</artifactId>
        </dependency>

        <!-- Spring 上下文（storage 基础设施 @Component / @ConfigurationProperties） -->
        <dependency>
            <groupId>org.springframework</groupId>
            <artifactId>spring-context</artifactId>
        </dependency>

        <!-- Spring Web（全局异常处理器 @RestControllerAdvice，共享层必备） -->
        <dependency>
            <groupId>org.springframework</groupId>
            <artifactId>spring-web</artifactId>
        </dependency>

        <!-- Validation（DTO 校验注解） -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>

        <!-- Jackson（Result 序列化 / 枚举） -->
        <dependency>
            <groupId>com.fasterxml.jackson.core</groupId>
            <artifactId>jackson-annotations</artifactId>
        </dependency>
        <dependency>
            <groupId>com.fasterxml.jackson.core</groupId>
            <artifactId>jackson-databind</artifactId>
        </dependency>

        <!-- Lombok -->
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <optional>true</optional>
        </dependency>

        <!-- 测试 -->
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.mockito</groupId>
            <artifactId>mockito-core</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <configuration>
                    <skip>true</skip>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
