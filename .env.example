# 本机存储绝对路径；Windows 使用正斜杠，Linux 示例 /data/manga。
MANGA_ROOT=F:/manga

# 本机 Docker MySQL：API/阅读服务读写，Worker 仅 SELECT。
MYSQL_ROOT_PASSWORD=请设置 MySQL root 强密码
API_MYSQL_USER=comicatlas_api
API_MYSQL_PASSWORD=请设置管理与阅读服务密码
WORKER_MYSQL_USER=comicatlas_ro
WORKER_MYSQL_PASSWORD=请设置 Worker 只读密码

# 本机 Docker Redis 与 RabbitMQ。
REDIS_PASSWORD=请设置 Redis 强密码
RABBITMQ_USER=comicatlas
RABBITMQ_PASSWORD=请设置 RabbitMQ 强密码

# 应用仅绑定本机回环地址，基础设施通过容器网络互通。
# 仅宿主机端口冲突时设置 MYSQL_PORT / REDIS_PORT / RABBITMQ_PORT /
# RABBITMQ_MANAGEMENT_PORT / NACOS_HTTP_PORT / NACOS_GRPC_PORT。
# Nacos 仅在本地部署网络使用，认证关闭，无需填写账号密码。

# 可选 LQ 调优：LQ_QUALITY / LQ_WORKERS / LQ_MAX_LONG_EDGE / LQ_MAX_INFLIGHT_PIXELS。

# 可选本地 AI 模型，需另备兼容 NVIDIA GPU、驱动与模型文件。
AI_BASE_URL=http://comic-model-service:23333/v1
AI_MODEL=OpenGVLab/InternVL3_5-2B
AI_API_KEY=local
AI_MODEL_DIR=./.runtime/models/InternVL3_5-2B
AI_MODEL_IMAGE=comicatlas-lmdeploy:local
# AI 默认使用本机 mysql 容器的 comic_atlas 库及 API 账号。
# 仅需独立账号时设置 AI_DB_NAME / AI_DB_USER / AI_DB_PASSWORD。
