# 使用 Docker 主机上的绝对路径。Windows 示例 C:/comicatlas-storage
COMICATLAS_STORAGE_ROOT=/srv/comicatlas-storage
COMICATLAS_WEB_PORT=18078
COMICATLAS_ADMIN_PORT=18079

# 可选 AI。启用 ai profile 时将端点设为 http://ai:8080。
COMICATLAS_AI_ENDPOINT=
COMICATLAS_AI_PROVIDER_URL=
COMICATLAS_AI_MODEL=
COMICATLAS_AI_PROVIDER_KEY=
