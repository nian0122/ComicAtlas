# 本机存储
MANGA_ROOT=F:/manga

# 项目服务访问基础设施的入口
# Docker Desktop 使用 host.docker.internal；本机直接启动由脚本映射为 localhost。
REMOTE_INFRA_HOST=host.docker.internal

# MySQL 部署与服务账号
MYSQL_ROOT_PASSWORD=请设置远端 MySQL root 强密码
API_MYSQL_USER=comicatlas_api
API_MYSQL_PASSWORD=请设置管理与阅读服务密码
WORKER_MYSQL_USER=comicatlas_ro
WORKER_MYSQL_PASSWORD=请设置 Worker 只读密码

# 远端基础设施端口
REMOTE_MYSQL_PORT=3306
REMOTE_REDIS_PORT=6379
REMOTE_RABBITMQ_PORT=5672
REMOTE_RABBITMQ_MANAGEMENT_PORT=15672
REMOTE_NACOS_HTTP_PORT=8848
REMOTE_NACOS_GRPC_PORT=9848

# 远端基础设施凭据
REMOTE_REDIS_PASSWORD=请设置 Redis 强密码
REMOTE_RABBITMQ_USER=comicatlas
REMOTE_RABBITMQ_PASSWORD=请设置 RabbitMQ 强密码
REMOTE_NACOS_USER=nacos
REMOTE_NACOS_PASSWORD=请设置 Nacos 强密码

# FRP 连接与认证
FRP_SERVER_ADDR=远端服务器公网地址
FRP_SERVER_PORT=7000
FRP_AUTH_TOKEN=运行 Initialize 自动生成
FRP_STCP_SECRET=运行 Initialize 自动生成
FRP_VISITOR_BIND_ADDR=0.0.0.0
FRP_PROVIDER_USER=comicatlas-infra
FRP_DASHBOARD_PORT=7500
FRP_DASHBOARD_USER=admin
FRP_DASHBOARD_PASSWORD=运行 Initialize 自动生成
