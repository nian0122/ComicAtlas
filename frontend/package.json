{
  "name": "frontend",
  "private": true,
  "version": "2.2.0",
  "type": "module",
  "packageManager": "pnpm@9.15.0",
  "scripts": {
    "typecheck": "vue-tsc -b",
    "build": "pnpm check:fsd && vue-tsc -b && vite build",
    "lint": "pnpm check:fsd && eslint .",
    "check:ui": "node scripts/check-ui-consolidation.mjs",
    "check:fsd": "node scripts/check-fsd-imports.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check . --end-of-line auto",
    "check": "pnpm check:ui && pnpm check:styles && pnpm typecheck && pnpm lint && pnpm format:check && pnpm build",
    "check:styles": "node scripts/check-style-contracts.mjs"
  },
  "dependencies": {
    "@element-plus/icons-vue": "^2.3.2",
    "axios": "^1.18.1",
    "element-plus": "^2.14.2",
    "pinia": "^3.0.4",
    "vue": "^3.5.38",
    "vue-router": "^4.6.4",
    "vue-virtual-scroller": "^2.0.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.13.2",
    "@vitejs/plugin-vue": "^6.0.7",
    "@vue/tsconfig": "^0.9.1",
    "eslint": "^10.9.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-vue": "^10.10.0",
    "globals": "^17.3.0",
    "prettier": "^3.9.6",
    "sass": "^1.101.0",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.68.0",
    "unplugin-vue-components": "^28.8.0",
    "vite": "^8.1.0",
    "vue-tsc": "^3.3.5"
  }
}
